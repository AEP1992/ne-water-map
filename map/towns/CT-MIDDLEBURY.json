ystem":"Middlebury Fuel"}],"more":0},{"year":2008,"tests":[],"violations":[{"y":2008,"contaminant":"Consumer Confidence Rule","health":false,"cat":"Other","measure":null,"unit":null,"limit":null,"from":"2008-08-10","to":null,"resolved":true,"system":"Middlebury Commons"}],"more":0},{"year":2007,"tests":[],"violations":[{"y":2007,"contaminant":"Consumer Confidence Rule","health":false,"cat":"Other","measure":null,"unit":null,"limit":null,"from":"2007-07-01","to":null,"resolved":true,"system":"Middlebury Commons"},{"y":2007,"contaminant":"Lead and Copper Rule","health":false,"cat":"MR","measure":null,"unit":null,"limit":null,"from":"2007-01-01","to":null,"resolved":true,"system":"Middlebury Commons"},{"y":2007,"contaminant":"Lead and Copper Rule","health":false,"cat":"MR","measure":null,"unit":null,"limit":null,"from":"2007-01-10","to":null,"resolved":false,"system":"Village Square"}],"more":0},{"year":2006,"tests":[],"violations":[{"y":2006,"contaminant":"Consumer Confidence Rule","health":false,"cat":"Other","measure":null,"unit":null,"limit":null,"from":"2006-07-01","to":null,"resolved":true,"system":"Westover Water Co"},{"y":2006,"contaminant":"Consumer Confidence Rule","health":false,"cat":"Other","measure":null,"unit":null,"limit":null,"from":"2006-08-10","to":null,"resolved":true,"system":"Westover Water Co"},{"y":2006,"contaminant":"Public Notice","health":false,"cat":"Other","measure":null,"unit":null,"limit":null,"from":"2006-07-22","to":null,"resolved":true,"system":"Middlebury Hamlet"},{"y":2006,"contaminant":"Public Notice","health":false,"cat":"Other","measure":null,"unit":null,"limit":null,"from":"2006-07-21","to":null,"resolved":true,"system":"Village Square"}],"more":0},{"year":2004,"tests":[],"violations":[{"y":2004,"contaminant":"Public Notice","health":false,"cat":"Other","measure":null,"unit":null,"limit":null,"from":"2004-11-15","to":null,"resolved":false,"system":"Wesson Shell #4"}],"more":0}],"first_year":2004,"last_year":2026,"explain":{"Copper":{"plain":"Copper, like lead, usually comes from the plumbing rather than the source \u2014 most often from copper pipe and its fittings, especially where water sits still.","effect":"Copper is an essential nutrient, but some people who drink water containing copper in excess of the action level over a relatively short amount of time could experience gastrointestinal distress. Some people who drink water containing copper in excess of the action level over many years could suffer liver or kidney damage.","source":"U.S. EPA, mandatory health effects language \u2014 Lead and Copper Rule","who":"People with Wilson's disease should consult their doctor.","kind":"contaminant","name":"Copper"},"Antimony, Total":{"plain":"Antimony reaches water from petroleum refineries, fire retardants, ceramics, electronics and solder.","effect":"Some people who drink water containing antimony well in excess of the maximum contaminant level over many years could experience increases in blood cholesterol and decreases in blood sugar.","source":"U.S. EPA, mandatory health effects language \u2014 Antimony","who":"Long-term exposure.","kind":"contaminant","name":"Antimony, Total"},"Arsenic":{"plain":"Arsenic occurs naturally in bedrock across much of New England \u2014 it is not usually a pollution problem, it is a geology problem. It is especially common in granite country.","effect":"Some people who drink water containing arsenic in excess of the maximum contaminant level over many years could experience skin damage or problems with their circulatory system, and may have an increased risk of getting cancer.","source":"U.S. EPA, mandatory health effects language \u2014 Arsenic","who":"Risk builds over years of exposure rather than suddenly.","kind":"contaminant","name":"Arsenic"},"Benzene":{"plain":"Benzene is an industrial solvent, and also reaches groundwater from leaking fuel storage tanks and landfills.","effect":"Some people who drink water containing benzene in excess of the maximum contaminant level over many years could experience anemia or a decrease in blood platelets, and may have an increased risk of getting cancer.","source":"U.S. EPA, mandatory health effects language \u2014 Benzene","who":"Long-term exposure.","kind":"contaminant","name":"Benzene"},"Fluoride":{"plain":"Fluoride occurs naturally in some groundwater and is added deliberately by many systems to reduce tooth decay. A violation usually means too much, not too little.","effect":"Some people who drink water containing fluoride in excess of the maximum contaminant level over many years could get bone disease, including pain and tenderness of the bones. Children may get mottled teeth.","source":"U.S. EPA, mandatory health effects language \u2014 Fluoride","who":"Children, for tooth mottling.","kind":"contaminant","name":"Fluoride"},"Nitrate":{"plain":"Nitrate usually comes from fertiliser run-off, septic systems, or manure. It is most common in farming areas and in shallow wells.","effect":"Infants below the age of six months who drink water containing nitrate in excess of the maximum contaminant level could become seriously ill and, if untreated, may die. Symptoms include shortness of breath and blue-baby syndrome.","source":"U.S. EPA, mandatory health effects language \u2014 Nitrate","who":"Infants under six months. This is the fastest-acting risk on this list.","kind":"contaminant","name":"Nitrate"},"Lead":{"plain":"Lead is almost never in water at its source. It gets picked up on the way to the tap \u2014 from the service line under the street, from solder in older joints, from the brass in the tap itself. That makes it a property of your building more than of your town.","effect":"Infants and children who drink water containing lead in excess of the action level could experience delays in their physical or mental development. Children could show slight deficits in attention span and learning abilities. Adults who drink this water over many years could develop kidney problems or high blood pressure.","source":"U.S. EPA, mandatory health effects language \u2014 Lead and Copper Rule","who":"Children and infants first.","kind":"contaminant","name":"Lead"},"Lead and Copper Rule":{"kind":"rule","name":"Lead and Copper Rule","plain":"The rule governing lead and copper monitoring and corrosion control. A violation is often procedural \u2014 a missed sampling round or a late report.","effect":null,"source":null,"who":null},"Revised Total Coliform Rule":{"plain":"Coliforms are bacteria that are mostly harmless in themselves. They are measured as an indicator: if they are present, the system may be open to something that is not harmless.","effect":"Coliforms are bacteria that are naturally present in the environment and are used as an indicator that other, potentially harmful, waterborne pathogens may be present or that a potential pathway exists through which contamination may enter the drinking water distribution system.","source":"U.S. EPA, mandatory health effects language \u2014 Revised Total Coliform Rule","who":"A warning sign rather than a harm in itself.","kind":"contaminant","name":"Revised Total Coliform Rule"},"Beryllium, Total":{"plain":"Beryllium enters water from metal refineries, coal-burning factories and electrical works, and from natural deposits.","effect":"Some people who drink water containing beryllium well in excess of the maximum contaminant level over many years could develop intestinal lesions.","source":"U.S. EPA, mandatory health effects language \u2014 Beryllium","who":"Long-term exposure.","kind":"contaminant","name":"Beryllium, Total"}}}