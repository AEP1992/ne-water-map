aminant":"Consumer Confidence Rule","health":false,"cat":"Other","measure":null,"unit":null,"limit":null,"from":"2005-07-01","to":null,"resolved":true,"system":"Ridgewood Hills Association System 1"},{"y":2005,"contaminant":"Consumer Confidence Rule","health":false,"cat":"Other","measure":null,"unit":null,"limit":null,"from":"2005-08-10","to":null,"resolved":true,"system":"Ridgewood Hills Association System 1"},{"y":2005,"contaminant":"Lead and Copper Rule","health":false,"cat":"MR","measure":null,"unit":null,"limit":null,"from":"2005-07-10","to":null,"resolved":true,"system":"The Clubhouse Of Ct River Valley"},{"y":2005,"contaminant":"Lead and Copper Rule","health":false,"cat":"MR","measure":null,"unit":null,"limit":null,"from":"2005-01-10","to":null,"resolved":true,"system":"Ridgewood Hills Association System 1"}],"more":0},{"year":2002,"tests":[],"violations":[{"y":2002,"contaminant":"Lead and Copper Rule","health":false,"cat":"MR","measure":null,"unit":null,"limit":null,"from":"2002-10-01","to":null,"resolved":true,"system":"John Winthrop Junior High School"},{"y":2002,"contaminant":"Lead and Copper Rule","health":false,"cat":"MR","measure":null,"unit":null,"limit":null,"from":"2002-10-01","to":null,"resolved":true,"system":"Valley Regional High School"}],"more":0}],"first_year":2002,"last_year":2026,"explain":{"Lead":{"plain":"Lead is almost never in water at its source. It gets picked up on the way to the tap \u2014 from the service line under the street, from solder in older joints, from the brass in the tap itself. That makes it a property of your building more than of your town.","effect":"Infants and children who drink water containing lead in excess of the action level could experience delays in their physical or mental development. Children could show slight deficits in attention span and learning abilities. Adults who drink this water over many years could develop kidney problems or high blood pressure.","source":"U.S. EPA, mandatory health effects language \u2014 Lead and Copper Rule","who":"Children and infants first.","kind":"contaminant","name":"Lead"},"Copper":{"plain":"Copper, like lead, usually comes from the plumbing rather than the source \u2014 most often from copper pipe and its fittings, especially where water sits still.","effect":"Copper is an essential nutrient, but some people who drink water containing copper in excess of the action level over a relatively short amount of time could experience gastrointestinal distress. Some people who drink water containing copper in excess of the action level over many years could suffer liver or kidney damage.","source":"U.S. EPA, mandatory health effects language \u2014 Lead and Copper Rule","who":"People with Wilson's disease should consult their doctor.","kind":"contaminant","name":"Copper"},"Revised Total Coliform Rule":{"plain":"Coliforms are bacteria that are mostly harmless in themselves. They are measured as an indicator: if they are present, the system may be open to something that is not harmless.","effect":"Coliforms are bacteria that are naturally present in the environment and are used as an indicator that other, potentially harmful, waterborne pathogens may be present or that a potential pathway exists through which contamination may enter the drinking water distribution system.","source":"U.S. EPA, mandatory health effects language \u2014 Revised Total Coliform Rule","who":"A warning sign rather than a harm in itself.","kind":"contaminant","name":"Revised Total Coliform Rule"},"LEAD AND COPPER RULE REVISIONS":{"kind":"rule","name":"LEAD AND COPPER RULE REVISIONS","plain":"A requirement about how a system must monitor for lead and copper, inventory its service lines, and act when results are high. A violation here is usually a failure to do the required work on schedule rather than a measured exceedance.","effect":null,"source":null,"who":null},"Lead and Copper Rule":{"kind":"rule","name":"Lead and Copper Rule","plain":"The rule governing lead and copper monitoring and corrosion control. A violation is often procedural \u2014 a missed sampling round or a late report.","effect":null,"source":null,"who":null}}}