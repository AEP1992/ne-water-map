":[{"y":2006,"contaminant":"Consumer Confidence Rule","health":false,"cat":"Other","measure":null,"unit":null,"limit":null,"from":"2006-07-01","to":null,"resolved":false,"system":"Dearborn Hill Apartments"}],"more":0},{"year":2004,"tests":[],"violations":[{"y":2004,"contaminant":"Consumer Confidence Rule","health":false,"cat":"Other","measure":null,"unit":null,"limit":null,"from":"2004-10-01","to":null,"resolved":true,"system":"East Vassalboro Water Company Llc"}],"more":0},{"year":2003,"tests":[],"violations":[{"y":2003,"contaminant":"Public Notice","health":false,"cat":"Other","measure":null,"unit":null,"limit":null,"from":"2003-09-27","to":null,"resolved":false,"system":"Dearborn Hill Apartments"}],"more":0}],"first_year":2003,"last_year":2025,"explain":{"Arsenic":{"plain":"Arsenic occurs naturally in bedrock across much of New England \u2014 it is not usually a pollution problem, it is a geology problem. It is especially common in granite country.","effect":"Some people who drink water containing arsenic in excess of the maximum contaminant level over many years could experience skin damage or problems with their circulatory system, and may have an increased risk of getting cancer.","source":"U.S. EPA, mandatory health effects language \u2014 Arsenic","who":"Risk builds over years of exposure rather than suddenly.","kind":"contaminant","name":"Arsenic"},"Lead":{"plain":"Lead is almost never in water at its source. It gets picked up on the way to the tap \u2014 from the service line under the street, from solder in older joints, from the brass in the tap itself. That makes it a property of your building more than of your town.","effect":"Infants and children who drink water containing lead in excess of the action level could experience delays in their physical or mental development. Children could show slight deficits in attention span and learning abilities. Adults who drink this water over many years could develop kidney problems or high blood pressure.","source":"U.S. EPA, mandatory health effects language \u2014 Lead and Copper Rule","who":"Children and infants first.","kind":"contaminant","name":"Lead"},"Revised Total Coliform Rule":{"plain":"Coliforms are bacteria that are mostly harmless in themselves. They are measured as an indicator: if they are present, the system may be open to something that is not harmless.","effect":"Coliforms are bacteria that are naturally present in the environment and are used as an indicator that other, potentially harmful, waterborne pathogens may be present or that a potential pathway exists through which contamination may enter the drinking water distribution system.","source":"U.S. EPA, mandatory health effects language \u2014 Revised Total Coliform Rule","who":"A warning sign rather than a harm in itself.","kind":"contaminant","name":"Revised Total Coliform Rule"},"Combined Radium (-226 and -228)":{"plain":"Radium is naturally radioactive and dissolves out of certain rock formations into groundwater. Like arsenic, it is a feature of local geology.","effect":"Some people who drink water containing radium 226 or 228 in excess of the maximum contaminant level over many years may have an increased risk of getting cancer.","source":"U.S. EPA, mandatory health effects language \u2014 Radionuclides","who":"Long-term exposure.","kind":"contaminant","name":"Combined Radium (-226 and -228)"},"Nitrate":{"plain":"Nitrate usually comes from fertiliser run-off, septic systems, or manure. It is most common in farming areas and in shallow wells.","effect":"Infants below the age of six months who drink water containing nitrate in excess of the maximum contaminant level could become seriously ill and, if untreated, may die. Symptoms include shortness of breath and blue-baby syndrome.","source":"U.S. EPA, mandatory health effects language \u2014 Nitrate","who":"Infants under six months. This is the fastest-acting risk on this list.","kind":"contaminant","name":"Nitrate"},"Lead and Copper Rule":{"kind":"rule","name":"Lead and Copper Rule","plain":"The rule governing lead and copper monitoring and corrosion control. A violation is often procedural \u2014 a missed sampling round or a late report.","effect":null,"source":null,"who":null}}}