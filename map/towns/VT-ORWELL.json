":0},{"year":2014,"tests":[],"violations":[{"y":2014,"contaminant":"E. COLI","health":false,"cat":"MR","measure":null,"unit":null,"limit":null,"from":"2014-12-31","to":null,"resolved":true,"system":"Orwell One Stop"},{"y":2014,"contaminant":"Nitrate","health":false,"cat":"MR","measure":null,"unit":null,"limit":null,"from":"2014-01-01","to":"2014-12-31","resolved":true,"system":"Chipman Point Marina"}],"more":0}],"first_year":2014,"last_year":2026,"explain":{"Benzene":{"plain":"Benzene is an industrial solvent, and also reaches groundwater from leaking fuel storage tanks and landfills.","effect":"Some people who drink water containing benzene in excess of the maximum contaminant level over many years could experience anemia or a decrease in blood platelets, and may have an increased risk of getting cancer.","source":"U.S. EPA, mandatory health effects language \u2014 Benzene","who":"Long-term exposure.","kind":"contaminant","name":"Benzene"},"Lead":{"plain":"Lead is almost never in water at its source. It gets picked up on the way to the tap \u2014 from the service line under the street, from solder in older joints, from the brass in the tap itself. That makes it a property of your building more than of your town.","effect":"Infants and children who drink water containing lead in excess of the action level could experience delays in their physical or mental development. Children could show slight deficits in attention span and learning abilities. Adults who drink this water over many years could develop kidney problems or high blood pressure.","source":"U.S. EPA, mandatory health effects language \u2014 Lead and Copper Rule","who":"Children and infants first.","kind":"contaminant","name":"Lead"},"Revised Total Coliform Rule":{"plain":"Coliforms are bacteria that are mostly harmless in themselves. They are measured as an indicator: if they are present, the system may be open to something that is not harmless.","effect":"Coliforms are bacteria that are naturally present in the environment and are used as an indicator that other, potentially harmful, waterborne pathogens may be present or that a potential pathway exists through which contamination may enter the drinking water distribution system.","source":"U.S. EPA, mandatory health effects language \u2014 Revised Total Coliform Rule","who":"A warning sign rather than a harm in itself.","kind":"contaminant","name":"Revised Total Coliform Rule"},"Nitrate":{"plain":"Nitrate usually comes from fertiliser run-off, septic systems, or manure. It is most common in farming areas and in shallow wells.","effect":"Infants below the age of six months who drink water containing nitrate in excess of the maximum contaminant level could become seriously ill and, if untreated, may die. Symptoms include shortness of breath and blue-baby syndrome.","source":"U.S. EPA, mandatory health effects language \u2014 Nitrate","who":"Infants under six months. This is the fastest-acting risk on this list.","kind":"contaminant","name":"Nitrate"}}}