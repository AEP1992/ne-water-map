,"resolved":true,"system":"Hopeville Pond S.P./Beach-Well #2"},{"y":2005,"contaminant":"Public Notice","health":false,"cat":"Other","measure":null,"unit":null,"limit":null,"from":"2005-11-10","to":null,"resolved":true,"system":"659 Voluntown Road"}],"more":0},{"year":2004,"tests":[],"violations":[{"y":2004,"contaminant":"Consumer Confidence Rule","health":false,"cat":"Other","measure":null,"unit":null,"limit":null,"from":"2004-07-01","to":null,"resolved":true,"system":"Griswold Healthcare Center"},{"y":2004,"contaminant":"Consumer Confidence Rule","health":false,"cat":"Other","measure":null,"unit":null,"limit":null,"from":"2004-08-10","to":null,"resolved":true,"system":"Griswold Healthcare Center"},{"y":2004,"contaminant":"Consumer Confidence Rule","health":false,"cat":"Other","measure":null,"unit":null,"limit":null,"from":"2004-07-01","to":null,"resolved":true,"system":"Griswold Mhp Llc"},{"y":2004,"contaminant":"Consumer Confidence Rule","health":false,"cat":"Other","measure":null,"unit":null,"limit":null,"from":"2004-08-10","to":null,"resolved":true,"system":"Griswold Mhp Llc"},{"y":2004,"contaminant":"Consumer Confidence Rule","health":false,"cat":"Other","measure":null,"unit":null,"limit":null,"from":"2004-07-01","to":null,"resolved":true,"system":"Ashland Pond Mobile Home Park"},{"y":2004,"contaminant":"Consumer Confidence Rule","health":false,"cat":"Other","measure":null,"unit":null,"limit":null,"from":"2004-08-10","to":null,"resolved":true,"system":"Ashland Pond Mobile Home Park"},{"y":2004,"contaminant":"Lead and Copper Rule","health":false,"cat":"MR","measure":null,"unit":null,"limit":null,"from":"2004-10-01","to":null,"resolved":true,"system":"Griswold Mhp Llc"},{"y":2004,"contaminant":"Public Notice","health":false,"cat":"Other","measure":null,"unit":null,"limit":null,"from":"2004-09-30","to":null,"resolved":false,"system":"Roosters Valero"}],"more":0},{"year":2003,"tests":[],"violations":[{"y":2003,"contaminant":"Lead and Copper Rule","health":false,"cat":"MR","measure":null,"unit":null,"limit":null,"from":"2003-10-01","to":null,"resolved":true,"system":"Griswold Healthcare Center"}],"more":0},{"year":2000,"tests":[],"violations":[{"y":2000,"contaminant":"Lead and Copper Rule","health":false,"cat":"MR","measure":null,"unit":null,"limit":null,"from":"2000-10-01","to":null,"resolved":true,"system":"Ctwc - Country Mobile Div."}],"more":0}],"first_year":2000,"last_year":2025,"explain":{"Arsenic":{"plain":"Arsenic occurs naturally in bedrock across much of New England \u2014 it is not usually a pollution problem, it is a geology problem. It is especially common in granite country.","effect":"Some people who drink water containing arsenic in excess of the maximum contaminant level over many years could experience skin damage or problems with their circulatory system, and may have an increased risk of getting cancer.","source":"U.S. EPA, mandatory health effects language \u2014 Arsenic","who":"Risk builds over years of exposure rather than suddenly.","kind":"contaminant","name":"Arsenic"},"Copper":{"plain":"Copper, like lead, usually comes from the plumbing rather than the source \u2014 most often from copper pipe and its fittings, especially where water sits still.","effect":"Copper is an essential nutrient, but some people who drink water containing copper in excess of the action level over a relatively short amount of time could experience gastrointestinal distress. Some people who drink water containing copper in excess of the action level over many years could suffer liver or kidney damage.","source":"U.S. EPA, mandatory health effects language \u2014 Lead and Copper Rule","who":"People with Wilson's disease should consult their doctor.","kind":"contaminant","name":"Copper"},"Antimony, Total":{"plain":"Antimony reaches water from petroleum refineries, fire retardants, ceramics, electronics and solder.","effect":"Some people who drink water containing antimony well in excess of the maximum contaminant level over many years could experience increases in blood cholesterol and decreases in blood sugar.","source":"U.S. EPA, mandatory health effects language \u2014 Antimony","who":"Long-term exposure.","kind":"contaminant","name":"Antimony, Total"},"Beryllium, Total":{"plain":"Beryllium enters water from metal refineries, coal-burning factories and electrical works, and from natural deposits.","effect":"Some people who drink water containing beryllium well in excess of the maximum contaminant level over many years could develop intestinal lesions.","source":"U.S. EPA, mandatory health effects language \u2014 Beryllium","who":"Long-term exposure.","kind":"contaminant","name":"Beryllium, Total"},"Gross Alpha, Excl. Radon and U":{"plain":"Gross alpha is a screening measurement rather than a single substance. It counts alpha-particle radioactivity from naturally occurring elements in rock, and a high reading prompts testing for the specific ones.","effect":"Certain minerals are radioactive and may emit a form of radiation known as alpha radiation. Some people who drink water containing alpha emitters in excess of the maximum contaminant level over many years may have an increased risk of getting cancer.","source":"U.S. EPA, mandatory health effects language \u2014 Radionuclides","who":"Long-term exposure.","kind":"contaminant","name":"Gross Alpha, Excl. Radon and U"},"Lead":{"plain":"Lead is almost never in water at its source. It gets picked up on the way to the tap \u2014 from the service line under the street, from solder in older joints, from the brass in the tap itself. That makes it a property of your building more than of your town.","effect":"Infants and children who drink water containing lead in excess of the action level could experience delays in their physical or mental development. Children could show slight deficits in attention span and learning abilities. Adults who drink this water over many years could develop kidney problems or high blood pressure.","source":"U.S. EPA, mandatory health effects language \u2014 Lead and Copper Rule","who":"Children and infants first.","kind":"contaminant","name":"Lead"},"Combined Radium (-226 and -228)":{"plain":"Radium is naturally radioactive and dissolves out of certain rock formations into groundwater. Like arsenic, it is a feature of local geology.","effect":"Some people who drink water containing radium 226 or 228 in excess of the maximum contaminant level over many years may have an increased risk of getting cancer.","source":"U.S. EPA, mandatory health effects language \u2014 Radionuclides","who":"Long-term exposure.","kind":"contaminant","name":"Combined Radium (-226 and -228)"},"Lead and Copper Rule":{"kind":"rule","name":"Lead and Copper Rule","plain":"The rule governing lead and copper monitoring and corrosion control. A violation is often procedural \u2014 a missed sampling round or a late report.","effect":null,"source":null,"who":null},"Fluoride":{"plain":"Fluoride occurs naturally in some groundwater and is added deliberately by many systems to reduce tooth decay. A violation usually means too much, not too little.","effect":"Some people who drink water containing fluoride in excess of the maximum contaminant level over many years could get bone disease, including pain and tenderness of the bones. Children may get mottled teeth.","source":"U.S. EPA, mandatory health effects language \u2014 Fluoride","who":"Children, for tooth mottling.","kind":"contaminant","name":"Fluoride"},"Total Haloacetic Acids (HAA5)":{"plain":"Like trihalomethanes, haloacetic acids form when disinfectant reacts with organic matter in the water. They are a side-effect of disinfection, not an added ingredient.","effect":"Some people who drink water containing haloacetic acids in excess of the maximum contaminant level over many years may have an increased risk of getting cancer.","source":"U.S. EPA, mandatory health effects language \u2014 Haloacetic Acids","who":"Long-term exposure.","kind":"contaminant","name":"Total Haloacetic Acids (HAA5)"},"Revised Total Coliform Rule":{"plain":"Coliforms are bacteria that are mostly harmless in themselves. They are measured as an indicator: if they are present, the system may be open to something that is not harmless.","effect":"Coliforms are bacteria that are naturally present in the environment and are used as an indicator that other, potentially harmful, waterborne pathogens may be present or that a potential pathway exists through which contamination may enter the drinking water distribution system.","source":"U.S. EPA, mandatory health effects language \u2014 Revised Total Coliform Rule","who":"A warning sign rather than a harm in itself.","kind":"contaminant","name":"Revised Total Coliform Rule"},"TTHM":{"plain":"Trihalomethanes are not added to water. They form when the chlorine used to disinfect it reacts with natural organic matter already present. They are a by-product of making water safe from bacteria.","effect":"Some people who drink water containing trihalomethanes in excess of the maximum contaminant level over many years could experience problems with their liver, kidneys, or central nervous system, and may have an increased risk of getting cancer.","source":"U.S. EPA, mandatory health effects language \u2014 Total Trihalomethanes","who":"Long-term exposure.","kind":"contaminant","name":"TTHM"}}}