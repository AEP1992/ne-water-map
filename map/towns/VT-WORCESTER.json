cat":"MR","measure":null,"unit":null,"limit":null,"from":"2021-01-01","to":"2021-03-31","resolved":true,"system":"Worcester Fire District 1"},{"y":2021,"contaminant":"Total Polychlorinated Biphenyls (PCB)","health":false,"cat":"MR","measure":null,"unit":null,"limit":null,"from":"2021-01-01","to":"2021-03-31","resolved":true,"system":"Worcester Fire District 1"},{"y":2021,"contaminant":"Toxaphene","health":false,"cat":"MR","measure":null,"unit":null,"limit":null,"from":"2021-01-01","to":"2021-03-31","resolved":true,"system":"Worcester Fire District 1"}],"more":0},{"year":2020,"tests":[{"y":2020,"contaminant":"Lead","value":0.7,"unit":"ppb","limit":15,"exceeds":false,"future":false,"from":"2018-01-01","to":"2020-12-31","system":"Worcester Fire District 1"}],"violations":[{"y":2020,"contaminant":"Consumer Confidence Rule","health":false,"cat":"Other","measure":null,"unit":null,"limit":null,"from":"2020-07-01","to":null,"resolved":false,"system":"Worcester Fire District 1"},{"y":2020,"contaminant":"Revised Total Coliform Rule","health":false,"cat":"Other","measure":null,"unit":null,"limit":null,"from":"2020-05-12","to":null,"resolved":true,"system":"Worcester Fire District 1"}],"more":0},{"year":2017,"tests":[{"y":2017,"contaminant":"Lead","value":1.0,"unit":"ppb","limit":15,"exceeds":false,"future":false,"from":"2015-01-01","to":"2017-12-31","system":"Worcester Fire District 1"}],"violations":[],"more":0},{"year":2014,"tests":[],"violations":[{"y":2014,"contaminant":"TTHM","health":false,"cat":"MR","measure":null,"unit":null,"limit":null,"from":"2014-09-01","to":"2017-08-31","resolved":true,"system":"Worcester Fire District 1"},{"y":2014,"contaminant":"Total Haloacetic Acids (HAA5)","health":false,"cat":"MR","measure":null,"unit":null,"limit":null,"from":"2014-09-01","to":"2017-08-31","resolved":true,"system":"Worcester Fire District 1"}],"more":0},{"year":2009,"tests":[],"violations":[{"y":2009,"contaminant":"Consumer Confidence Rule","health":false,"cat":"Other","measure":null,"unit":null,"limit":null,"from":"2009-07-01","to":null,"resolved":true,"system":"Worcester Fire District 1"}],"more":0}],"first_year":2009,"last_year":2025,"explain":{"Arsenic":{"plain":"Arsenic occurs naturally in bedrock across much of New England \u2014 it is not usually a pollution problem, it is a geology problem. It is especially common in granite country.","effect":"Some people who drink water containing arsenic in excess of the maximum contaminant level over many years could experience skin damage or problems with their circulatory system, and may have an increased risk of getting cancer.","source":"U.S. EPA, mandatory health effects language \u2014 Arsenic","who":"Risk builds over years of exposure rather than suddenly.","kind":"contaminant","name":"Arsenic"},"Antimony, Total":{"plain":"Antimony reaches water from petroleum refineries, fire retardants, ceramics, electronics and solder.","effect":"Some people who drink water containing antimony well in excess of the maximum contaminant level over many years could experience increases in blood cholesterol and decreases in blood sugar.","source":"U.S. EPA, mandatory health effects language \u2014 Antimony","who":"Long-term exposure.","kind":"contaminant","name":"Antimony, Total"},"Beryllium, Total":{"plain":"Beryllium enters water from metal refineries, coal-burning factories and electrical works, and from natural deposits.","effect":"Some people who drink water containing beryllium well in excess of the maximum contaminant level over many years could develop intestinal lesions.","source":"U.S. EPA, mandatory health effects language \u2014 Beryllium","who":"Long-term exposure.","kind":"contaminant","name":"Beryllium, Total"},"Gross Alpha, Excl. Radon and U":{"plain":"Gross alpha is a screening measurement rather than a single substance. It counts alpha-particle radioactivity from naturally occurring elements in rock, and a high reading prompts testing for the specific ones.","effect":"Certain minerals are radioactive and may emit a form of radiation known as alpha radiation. Some people who drink water containing alpha emitters in excess of the maximum contaminant level over many years may have an increased risk of getting cancer.","source":"U.S. EPA, mandatory health effects language \u2014 Radionuclides","who":"Long-term exposure.","kind":"contaminant","name":"Gross Alpha, Excl. Radon and U"},"Lead":{"plain":"Lead is almost never in water at its source. It gets picked up on the way to the tap \u2014 from the service line under the street, from solder in older joints, from the brass in the tap itself. That makes it a property of your building more than of your town.","effect":"Infants and children who drink water containing lead in excess of the action level could experience delays in their physical or mental development. Children could show slight deficits in attention span and learning abilities. Adults who drink this water over many years could develop kidney problems or high blood pressure.","source":"U.S. EPA, mandatory health effects language \u2014 Lead and Copper Rule","who":"Children and infants first.","kind":"contaminant","name":"Lead"},"Lead and Copper Rule":{"kind":"rule","name":"Lead and Copper Rule","plain":"The rule governing lead and copper monitoring and corrosion control. A violation is often procedural \u2014 a missed sampling round or a late report.","effect":null,"source":null,"who":null},"Total Haloacetic Acids (HAA5)":{"plain":"Like trihalomethanes, haloacetic acids form when disinfectant reacts with organic matter in the water. They are a side-effect of disinfection, not an added ingredient.","effect":"Some people who drink water containing haloacetic acids in excess of the maximum contaminant level over many years may have an increased risk of getting cancer.","source":"U.S. EPA, mandatory health effects language \u2014 Haloacetic Acids","who":"Long-term exposure.","kind":"contaminant","name":"Total Haloacetic Acids (HAA5)"},"Fluoride":{"plain":"Fluoride occurs naturally in some groundwater and is added deliberately by many systems to reduce tooth decay. A violation usually means too much, not too little.","effect":"Some people who drink water containing fluoride in excess of the maximum contaminant level over many years could get bone disease, including pain and tenderness of the bones. Children may get mottled teeth.","source":"U.S. EPA, mandatory health effects language \u2014 Fluoride","who":"Children, for tooth mottling.","kind":"contaminant","name":"Fluoride"},"Revised Total Coliform Rule":{"plain":"Coliforms are bacteria that are mostly harmless in themselves. They are measured as an indicator: if they are present, the system may be open to something that is not harmless.","effect":"Coliforms are bacteria that are naturally present in the environment and are used as an indicator that other, potentially harmful, waterborne pathogens may be present or that a potential pathway exists through which contamination may enter the drinking water distribution system.","source":"U.S. EPA, mandatory health effects language \u2014 Revised Total Coliform Rule","who":"A warning sign rather than a harm in itself.","kind":"contaminant","name":"Revised Total Coliform Rule"},"TTHM":{"plain":"Trihalomethanes are not added to water. They form when the chlorine used to disinfect it reacts with natural organic matter already present. They are a by-product of making water safe from bacteria.","effect":"Some people who drink water containing trihalomethanes in excess of the maximum contaminant level over many years could experience problems with their liver, kidneys, or central nervous system, and may have an increased risk of getting cancer.","source":"U.S. EPA, mandatory health effects language \u2014 Total Trihalomethanes","who":"Long-term exposure.","kind":"contaminant","name":"TTHM"},"Nitrate":{"plain":"Nitrate usually comes from fertiliser run-off, septic systems, or manure. It is most common in farming areas and in shallow wells.","effect":"Infants below the age of six months who drink water containing nitrate in excess of the maximum contaminant level could become seriously ill and, if untreated, may die. Symptoms include shortness of breath and blue-baby syndrome.","source":"U.S. EPA, mandatory health effects language \u2014 Nitrate","who":"Infants under six months. This is the fastest-acting risk on this list.","kind":"contaminant","name":"Nitrate"}}}