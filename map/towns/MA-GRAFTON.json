ll,"limit":null,"from":"2018-12-10","to":null,"resolved":true,"system":"Countryside Condominium"},{"y":2018,"contaminant":"Lead and Copper Rule","health":false,"cat":"MR","measure":null,"unit":null,"limit":null,"from":"2018-10-01","to":null,"resolved":true,"system":"Grafton Water District"}],"more":0},{"year":2017,"tests":[{"y":2017,"contaminant":"Lead","value":1.6,"unit":"ppb","limit":15,"exceeds":false,"future":false,"from":"2015-01-01","to":"2017-12-31","system":"Silver Spruce Montessori School"}],"violations":[{"y":2017,"contaminant":"Lead and Copper Rule","health":false,"cat":"MR","measure":null,"unit":null,"limit":null,"from":"2017-12-30","to":null,"resolved":true,"system":"Touchstone Community School"}],"more":0},{"year":2016,"tests":[{"y":2016,"contaminant":"Lead","value":4.2,"unit":"ppb","limit":15,"exceeds":false,"future":false,"from":"2014-01-01","to":"2016-12-31","system":"Grafton Water District"},{"y":2016,"contaminant":"Lead","value":2.6,"unit":"ppb","limit":15,"exceeds":false,"future":false,"from":"2014-01-01","to":"2016-12-31","system":"South Grafton Water District"},{"y":2016,"contaminant":"Lead","value":0.0,"unit":"ppb","limit":15,"exceeds":false,"future":false,"from":"2014-01-01","to":"2016-12-31","system":"Touchstone Community School"}],"violations":[],"more":0},{"year":2012,"tests":[],"violations":[{"y":2012,"contaminant":"Consumer Confidence Rule","health":false,"cat":"Other","measure":null,"unit":null,"limit":null,"from":"2012-07-01","to":null,"resolved":true,"system":"Laurel Hill Condominiums"}],"more":0},{"year":2006,"tests":[],"violations":[{"y":2006,"contaminant":"Consumer Confidence Rule","health":false,"cat":"Other","measure":null,"unit":null,"limit":null,"from":"2006-07-01","to":null,"resolved":true,"system":"Countryside Condominium"}],"more":0}],"first_year":2006,"last_year":2026,"explain":{"Groundwater Rule":{"kind":"rule","name":"Groundwater Rule","plain":"A requirement for systems using groundwater to identify and correct faecal contamination risks. A violation usually means required monitoring or corrective action was not completed.","effect":null,"source":null,"who":null},"Arsenic":{"plain":"Arsenic occurs naturally in bedrock across much of New England \u2014 it is not usually a pollution problem, it is a geology problem. It is especially common in granite country.","effect":"Some people who drink water containing arsenic in excess of the maximum contaminant level over many years could experience skin damage or problems with their circulatory system, and may have an increased risk of getting cancer.","source":"U.S. EPA, mandatory health effects language \u2014 Arsenic","who":"Risk builds over years of exposure rather than suddenly.","kind":"contaminant","name":"Arsenic"},"Copper":{"plain":"Copper, like lead, usually comes from the plumbing rather than the source \u2014 most often from copper pipe and its fittings, especially where water sits still.","effect":"Copper is an essential nutrient, but some people who drink water containing copper in excess of the action level over a relatively short amount of time could experience gastrointestinal distress. Some people who drink water containing copper in excess of the action level over many years could suffer liver or kidney damage.","source":"U.S. EPA, mandatory health effects language \u2014 Lead and Copper Rule","who":"People with Wilson's disease should consult their doctor.","kind":"contaminant","name":"Copper"},"Benzene":{"plain":"Benzene is an industrial solvent, and also reaches groundwater from leaking fuel storage tanks and landfills.","effect":"Some people who drink water containing benzene in excess of the maximum contaminant level over many years could experience anemia or a decrease in blood platelets, and may have an increased risk of getting cancer.","source":"U.S. EPA, mandatory health effects language \u2014 Benzene","who":"Long-term exposure.","kind":"contaminant","name":"Benzene"},"Antimony, Total":{"plain":"Antimony reaches water from petroleum refineries, fire retardants, ceramics, electronics and solder.","effect":"Some people who drink water containing antimony well in excess of the maximum contaminant level over many years could experience increases in blood cholesterol and decreases in blood sugar.","source":"U.S. EPA, mandatory health effects language \u2014 Antimony","who":"Long-term exposure.","kind":"contaminant","name":"Antimony, Total"},"Beryllium, Total":{"plain":"Beryllium enters water from metal refineries, coal-burning factories and electrical works, and from natural deposits.","effect":"Some people who drink water containing beryllium well in excess of the maximum contaminant level over many years could develop intestinal lesions.","source":"U.S. EPA, mandatory health effects language \u2014 Beryllium","who":"Long-term exposure.","kind":"contaminant","name":"Beryllium, Total"},"Lead":{"plain":"Lead is almost never in water at its source. It gets picked up on the way to the tap \u2014 from the service line under the street, from solder in older joints, from the brass in the tap itself. That makes it a property of your building more than of your town.","effect":"Infants and children who drink water containing lead in excess of the action level could experience delays in their physical or mental development. Children could show slight deficits in attention span and learning abilities. Adults who drink this water over many years could develop kidney problems or high blood pressure.","source":"U.S. EPA, mandatory health effects language \u2014 Lead and Copper Rule","who":"Children and infants first.","kind":"contaminant","name":"Lead"},"Lead and Copper Rule":{"kind":"rule","name":"Lead and Copper Rule","plain":"The rule governing lead and copper monitoring and corrosion control. A violation is often procedural \u2014 a missed sampling round or a late report.","effect":null,"source":null,"who":null},"Fluoride":{"plain":"Fluoride occurs naturally in some groundwater and is added deliberately by many systems to reduce tooth decay. A violation usually means too much, not too little.","effect":"Some people who drink water containing fluoride in excess of the maximum contaminant level over many years could get bone disease, including pain and tenderness of the bones. Children may get mottled teeth.","source":"U.S. EPA, mandatory health effects language \u2014 Fluoride","who":"Children, for tooth mottling.","kind":"contaminant","name":"Fluoride"},"Revised Total Coliform Rule":{"plain":"Coliforms are bacteria that are mostly harmless in themselves. They are measured as an indicator: if they are present, the system may be open to something that is not harmless.","effect":"Coliforms are bacteria that are naturally present in the environment and are used as an indicator that other, potentially harmful, waterborne pathogens may be present or that a potential pathway exists through which contamination may enter the drinking water distribution system.","source":"U.S. EPA, mandatory health effects language \u2014 Revised Total Coliform Rule","who":"A warning sign rather than a harm in itself.","kind":"contaminant","name":"Revised Total Coliform Rule"},"Nitrate":{"plain":"Nitrate usually comes from fertiliser run-off, septic systems, or manure. It is most common in farming areas and in shallow wells.","effect":"Infants below the age of six months who drink water containing nitrate in excess of the maximum contaminant level could become seriously ill and, if untreated, may die. Symptoms include shortness of breath and blue-baby syndrome.","source":"U.S. EPA, mandatory health effects language \u2014 Nitrate","who":"Infants under six months. This is the fastest-acting risk on this list.","kind":"contaminant","name":"Nitrate"}}}