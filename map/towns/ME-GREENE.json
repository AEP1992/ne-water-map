minant":"Chloromethane","health":false,"cat":"MR","measure":null,"unit":null,"limit":null,"from":"2002-01-01","to":"2002-12-31","resolved":false,"system":"Glenrock Spring"},{"y":2002,"contaminant":"DICHLOROMETHANE","health":false,"cat":"MR","measure":null,"unit":null,"limit":null,"from":"2002-01-01","to":"2002-12-31","resolved":false,"system":"Glenrock Spring"},{"y":2002,"contaminant":"Dibromochloromethane","health":false,"cat":"MR","measure":null,"unit":null,"limit":null,"from":"2002-01-01","to":"2002-12-31","resolved":false,"system":"Glenrock Spring"},{"y":2002,"contaminant":"Dibromomethane","health":false,"cat":"MR","measure":null,"unit":null,"limit":null,"from":"2002-01-01","to":"2002-12-31","resolved":false,"system":"Glenrock Spring"},{"y":2002,"contaminant":"Ethylbenzene","health":false,"cat":"MR","measure":null,"unit":null,"limit":null,"from":"2002-01-01","to":"2002-12-31","resolved":false,"system":"Glenrock Spring"},{"y":2002,"contaminant":"Hexachlorobutadiene","health":false,"cat":"MR","measure":null,"unit":null,"limit":null,"from":"2002-01-01","to":"2002-12-31","resolved":false,"system":"Glenrock Spring"},{"y":2002,"contaminant":"Styrene","health":false,"cat":"MR","measure":null,"unit":null,"limit":null,"from":"2002-01-01","to":"2002-12-31","resolved":false,"system":"Glenrock Spring"},{"y":2002,"contaminant":"Tetrachloroethylene","health":false,"cat":"MR","measure":null,"unit":null,"limit":null,"from":"2002-01-01","to":"2002-12-31","resolved":false,"system":"Glenrock Spring"},{"y":2002,"contaminant":"Toluene","health":false,"cat":"MR","measure":null,"unit":null,"limit":null,"from":"2002-01-01","to":"2002-12-31","resolved":false,"system":"Glenrock Spring"},{"y":2002,"contaminant":"Trichloroethylene","health":false,"cat":"MR","measure":null,"unit":null,"limit":null,"from":"2002-01-01","to":"2002-12-31","resolved":false,"system":"Glenrock Spring"},{"y":2002,"contaminant":"Vinyl chloride","health":false,"cat":"MR","measure":null,"unit":null,"limit":null,"from":"2002-01-01","to":"2002-12-31","resolved":false,"system":"Glenrock Spring"},{"y":2002,"contaminant":"Xylenes, Total","health":false,"cat":"MR","measure":null,"unit":null,"limit":null,"from":"2002-01-01","to":"2002-12-31","resolved":false,"system":"Glenrock Spring"},{"y":2002,"contaminant":"cis-1,2-Dichloroethylene","health":false,"cat":"MR","measure":null,"unit":null,"limit":null,"from":"2002-01-01","to":"2002-12-31","resolved":false,"system":"Glenrock Spring"}],"more":0}],"first_year":2002,"last_year":2026,"explain":{"Arsenic":{"plain":"Arsenic occurs naturally in bedrock across much of New England \u2014 it is not usually a pollution problem, it is a geology problem. It is especially common in granite country.","effect":"Some people who drink water containing arsenic in excess of the maximum contaminant level over many years could experience skin damage or problems with their circulatory system, and may have an increased risk of getting cancer.","source":"U.S. EPA, mandatory health effects language \u2014 Arsenic","who":"Risk builds over years of exposure rather than suddenly.","kind":"contaminant","name":"Arsenic"},"Benzene":{"plain":"Benzene is an industrial solvent, and also reaches groundwater from leaking fuel storage tanks and landfills.","effect":"Some people who drink water containing benzene in excess of the maximum contaminant level over many years could experience anemia or a decrease in blood platelets, and may have an increased risk of getting cancer.","source":"U.S. EPA, mandatory health effects language \u2014 Benzene","who":"Long-term exposure.","kind":"contaminant","name":"Benzene"},"Antimony, Total":{"plain":"Antimony reaches water from petroleum refineries, fire retardants, ceramics, electronics and solder.","effect":"Some people who drink water containing antimony well in excess of the maximum contaminant level over many years could experience increases in blood cholesterol and decreases in blood sugar.","source":"U.S. EPA, mandatory health effects language \u2014 Antimony","who":"Long-term exposure.","kind":"contaminant","name":"Antimony, Total"},"Beryllium, Total":{"plain":"Beryllium enters water from metal refineries, coal-burning factories and electrical works, and from natural deposits.","effect":"Some people who drink water containing beryllium well in excess of the maximum contaminant level over many years could develop intestinal lesions.","source":"U.S. EPA, mandatory health effects language \u2014 Beryllium","who":"Long-term exposure.","kind":"contaminant","name":"Beryllium, Total"},"Lead":{"plain":"Lead is almost never in water at its source. It gets picked up on the way to the tap \u2014 from the service line under the street, from solder in older joints, from the brass in the tap itself. That makes it a property of your building more than of your town.","effect":"Infants and children who drink water containing lead in excess of the action level could experience delays in their physical or mental development. Children could show slight deficits in attention span and learning abilities. Adults who drink this water over many years could develop kidney problems or high blood pressure.","source":"U.S. EPA, mandatory health effects language \u2014 Lead and Copper Rule","who":"Children and infants first.","kind":"contaminant","name":"Lead"},"Combined Radium (-226 and -228)":{"plain":"Radium is naturally radioactive and dissolves out of certain rock formations into groundwater. Like arsenic, it is a feature of local geology.","effect":"Some people who drink water containing radium 226 or 228 in excess of the maximum contaminant level over many years may have an increased risk of getting cancer.","source":"U.S. EPA, mandatory health effects language \u2014 Radionuclides","who":"Long-term exposure.","kind":"contaminant","name":"Combined Radium (-226 and -228)"},"Lead and Copper Rule":{"kind":"rule","name":"Lead and Copper Rule","plain":"The rule governing lead and copper monitoring and corrosion control. A violation is often procedural \u2014 a missed sampling round or a late report.","effect":null,"source":null,"who":null},"Fluoride":{"plain":"Fluoride occurs naturally in some groundwater and is added deliberately by many systems to reduce tooth decay. A violation usually means too much, not too little.","effect":"Some people who drink water containing fluoride in excess of the maximum contaminant level over many years could get bone disease, including pain and tenderness of the bones. Children may get mottled teeth.","source":"U.S. EPA, mandatory health effects language \u2014 Fluoride","who":"Children, for tooth mottling.","kind":"contaminant","name":"Fluoride"},"Revised Total Coliform Rule":{"plain":"Coliforms are bacteria that are mostly harmless in themselves. They are measured as an indicator: if they are present, the system may be open to something that is not harmless.","effect":"Coliforms are bacteria that are naturally present in the environment and are used as an indicator that other, potentially harmful, waterborne pathogens may be present or that a potential pathway exists through which contamination may enter the drinking water distribution system.","source":"U.S. EPA, mandatory health effects language \u2014 Revised Total Coliform Rule","who":"A warning sign rather than a harm in itself.","kind":"contaminant","name":"Revised Total Coliform Rule"},"Nitrate":{"plain":"Nitrate usually comes from fertiliser run-off, septic systems, or manure. It is most common in farming areas and in shallow wells.","effect":"Infants below the age of six months who drink water containing nitrate in excess of the maximum contaminant level could become seriously ill and, if untreated, may die. Symptoms include shortness of breath and blue-baby syndrome.","source":"U.S. EPA, mandatory health effects language \u2014 Nitrate","who":"Infants under six months. This is the fastest-acting risk on this list.","kind":"contaminant","name":"Nitrate"}}}