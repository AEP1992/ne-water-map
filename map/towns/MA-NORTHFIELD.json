cademy"},{"y":2002,"contaminant":"cis-1,2-Dichloroethylene","health":false,"cat":"MR","measure":null,"unit":null,"limit":null,"from":"2002-04-01","to":"2002-06-30","resolved":false,"system":"Redemption Christian Academy"},{"y":2002,"contaminant":"o-Dichlorobenzene","health":false,"cat":"MR","measure":null,"unit":null,"limit":null,"from":"2002-04-01","to":"2002-06-30","resolved":false,"system":"Redemption Christian Academy"},{"y":2002,"contaminant":"p-Dichlorobenzene","health":false,"cat":"MR","measure":null,"unit":null,"limit":null,"from":"2002-04-01","to":"2002-06-30","resolved":false,"system":"Redemption Christian Academy"},{"y":2002,"contaminant":"p-Xylene","health":false,"cat":"MR","measure":null,"unit":null,"limit":null,"from":"2002-04-01","to":"2002-06-30","resolved":false,"system":"Redemption Christian Academy"},{"y":2002,"contaminant":"trans-1,2-Dichloroethylene","health":false,"cat":"MR","measure":null,"unit":null,"limit":null,"from":"2002-04-01","to":"2002-06-30","resolved":false,"system":"Redemption Christian Academy"}],"more":0},{"year":2001,"tests":[],"violations":[{"y":2001,"contaminant":"Consumer Confidence Rule","health":false,"cat":"Other","measure":null,"unit":null,"limit":null,"from":"2001-07-01","to":null,"resolved":true,"system":"Northfield Water District"}],"more":0},{"year":2000,"tests":[],"violations":[{"y":2000,"contaminant":"Lead and Copper Rule","health":true,"cat":"TT","measure":null,"unit":null,"limit":null,"from":"2000-01-01","to":null,"resolved":true,"system":"Northfield Water District"}],"more":0}],"first_year":2000,"last_year":2025,"explain":{"Benzene":{"plain":"Benzene is an industrial solvent, and also reaches groundwater from leaking fuel storage tanks and landfills.","effect":"Some people who drink water containing benzene in excess of the maximum contaminant level over many years could experience anemia or a decrease in blood platelets, and may have an increased risk of getting cancer.","source":"U.S. EPA, mandatory health effects language \u2014 Benzene","who":"Long-term exposure.","kind":"contaminant","name":"Benzene"},"Lead":{"plain":"Lead is almost never in water at its source. It gets picked up on the way to the tap \u2014 from the service line under the street, from solder in older joints, from the brass in the tap itself. That makes it a property of your building more than of your town.","effect":"Infants and children who drink water containing lead in excess of the action level could experience delays in their physical or mental development. Children could show slight deficits in attention span and learning abilities. Adults who drink this water over many years could develop kidney problems or high blood pressure.","source":"U.S. EPA, mandatory health effects language \u2014 Lead and Copper Rule","who":"Children and infants first.","kind":"contaminant","name":"Lead"},"Lead and Copper Rule":{"kind":"rule","name":"Lead and Copper Rule","plain":"The rule governing lead and copper monitoring and corrosion control. A violation is often procedural \u2014 a missed sampling round or a late report.","effect":null,"source":null,"who":null},"Total Haloacetic Acids (HAA5)":{"plain":"Like trihalomethanes, haloacetic acids form when disinfectant reacts with organic matter in the water. They are a side-effect of disinfection, not an added ingredient.","effect":"Some people who drink water containing haloacetic acids in excess of the maximum contaminant level over many years may have an increased risk of getting cancer.","source":"U.S. EPA, mandatory health effects language \u2014 Haloacetic Acids","who":"Long-term exposure.","kind":"contaminant","name":"Total Haloacetic Acids (HAA5)"},"Revised Total Coliform Rule":{"plain":"Coliforms are bacteria that are mostly harmless in themselves. They are measured as an indicator: if they are present, the system may be open to something that is not harmless.","effect":"Coliforms are bacteria that are naturally present in the environment and are used as an indicator that other, potentially harmful, waterborne pathogens may be present or that a potential pathway exists through which contamination may enter the drinking water distribution system.","source":"U.S. EPA, mandatory health effects language \u2014 Revised Total Coliform Rule","who":"A warning sign rather than a harm in itself.","kind":"contaminant","name":"Revised Total Coliform Rule"},"TTHM":{"plain":"Trihalomethanes are not added to water. They form when the chlorine used to disinfect it reacts with natural organic matter already present. They are a by-product of making water safe from bacteria.","effect":"Some people who drink water containing trihalomethanes in excess of the maximum contaminant level over many years could experience problems with their liver, kidneys, or central nervous system, and may have an increased risk of getting cancer.","source":"U.S. EPA, mandatory health effects language \u2014 Total Trihalomethanes","who":"Long-term exposure.","kind":"contaminant","name":"TTHM"}}}