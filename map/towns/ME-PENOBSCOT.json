form Rule"},"Combined Radium (-226 and -228)":{"plain":"Radium is naturally radioactive and dissolves out of certain rock formations into groundwater. Like arsenic, it is a feature of local geology.","effect":"Some people who drink water containing radium 226 or 228 in excess of the maximum contaminant level over many years may have an increased risk of getting cancer.","source":"U.S. EPA, mandatory health effects language \u2014 Radionuclides","who":"Long-term exposure.","kind":"contaminant","name":"Combined Radium (-226 and -228)"},"Lead and Copper Rule":{"kind":"rule","name":"Lead and Copper Rule","plain":"The rule governing lead and copper monitoring and corrosion control. A violation is often procedural \u2014 a missed sampling round or a late report.","effect":null,"source":null,"who":null}}}