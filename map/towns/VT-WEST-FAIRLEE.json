s":[],"violations":[{"y":2001,"contaminant":"Coliform (TCR)","health":true,"cat":"MCL","measure":null,"unit":null,"limit":null,"from":"2001-07-01","to":"2001-07-31","resolved":true,"system":"West Fairlee Mhp"}],"more":0},{"year":2000,"tests":[],"violations":[{"y":2000,"contaminant":"Coliform (TCR)","health":true,"cat":"MCL","measure":null,"unit":null,"limit":null,"from":"2000-07-01","to":"2000-07-31","resolved":true,"system":"West Fairlee Mhp"}],"more":0}],"first_year":2000,"last_year":2025,"explain":{"Benzene":{"plain":"Benzene is an industrial solvent, and also reaches groundwater from leaking fuel storage tanks and landfills.","effect":"Some people who drink water containing benzene in excess of the maximum contaminant level over many years could experience anemia or a decrease in blood platelets, and may have an increased risk of getting cancer.","source":"U.S. EPA, mandatory health effects language \u2014 Benzene","who":"Long-term exposure.","kind":"contaminant","name":"Benzene"},"Lead":{"plain":"Lead is almost never in water at its source. It gets picked up on the way to the tap \u2014 from the service line under the street, from solder in older joints, from the brass in the tap itself. That makes it a property of your building more than of your town.","effect":"Infants and children who drink water containing lead in excess of the action level could experience delays in their physical or mental development. Children could show slight deficits in attention span and learning abilities. Adults who drink this water over many years could develop kidney problems or high blood pressure.","source":"U.S. EPA, mandatory health effects language \u2014 Lead and Copper Rule","who":"Children and infants first.","kind":"contaminant","name":"Lead"},"Total Haloacetic Acids (HAA5)":{"plain":"Like trihalomethanes, haloacetic acids form when disinfectant reacts with organic matter in the water. They are a side-effect of disinfection, not an added ingredient.","effect":"Some people who drink water containing haloacetic acids in excess of the maximum contaminant level over many years may have an increased risk of getting cancer.","source":"U.S. EPA, mandatory health effects language \u2014 Haloacetic Acids","who":"Long-term exposure.","kind":"contaminant","name":"Total Haloacetic Acids (HAA5)"},"TTHM":{"plain":"Trihalomethanes are not added to water. They form when the chlorine used to disinfect it reacts with natural organic matter already present. They are a by-product of making water safe from bacteria.","effect":"Some people who drink water containing trihalomethanes in excess of the maximum contaminant level over many years could experience problems with their liver, kidneys, or central nervous system, and may have an increased risk of getting cancer.","source":"U.S. EPA, mandatory health effects language \u2014 Total Trihalomethanes","who":"Long-term exposure.","kind":"contaminant","name":"TTHM"},"Nitrate":{"plain":"Nitrate usually comes from fertiliser run-off, septic systems, or manure. It is most common in farming areas and in shallow wells.","effect":"Infants below the age of six months who drink water containing nitrate in excess of the maximum contaminant level could become seriously ill and, if untreated, may die. Symptoms include shortness of breath and blue-baby syndrome.","source":"U.S. EPA, mandatory health effects language \u2014 Nitrate","who":"Infants under six months. This is the fastest-acting risk on this list.","kind":"contaminant","name":"Nitrate"}}}